  "cards": [
    {
      "dot": "cyan",
      "title": "Run path",
      "items": [
        "One orchestrator drives every entry point: run, schedule, bot, doctor",
        "Connectors fetch a time window; the pipeline normalizes, dedupes, scores, ranks, and selects",
        "Selection yields Must-read, Skim, and Videos; LLM paths fall back to deterministic ones"
      ]
    },
    {
      "dot": "emerald",
      "title": "State and observability",
      "items": [
        "SQLite holds runs, raw and adjusted scores, seen state, and feedback rows",
        "Delivered Telegram chunks and the Obsidian note are archived per run id",
        "Thumbs taps and /feedback become ranking bias on the next run"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries",
      "items": [
        "No HTTP control plane; Telegram is the only remote surface, restricted to admin ids",
        "Tracked config is never mutated - bot edits write delta-only local overlays",
        "A run lock prevents overlapping runs across CLI, bot, and scheduler"
      ]
    }
  ]
